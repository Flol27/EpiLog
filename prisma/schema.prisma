// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  id         Int     @id @default(autoincrement())
  isbn       String  @unique
  title      String?
  totalPages Int?

  bookUsers BookUser[]
  reviews   Review[]
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  username          String    @unique
  password          String
  role              String    @default("user")
  firstname         String
  lastname          String?
  readStreak        Int       @default(0)
  readStreakUpdated DateTime?
  profilePic        String?
  status            String?
  quote             String?
  createdAt         DateTime  @default(now())

  bookUsers       BookUser[]
  reviews         Review[]
  friendshipsFrom Friendship[] @relation("FriendshipFrom")
  friendshipsTo   Friendship[] @relation("FriendshipTo")
}

model BookUser {
  userId     Int
  bookId     Int
  pagesRead  Int?
  startDate  DateTime?
  readDate   DateTime?
  updatedAt  DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
}

model Friendship {
  fromId    Int
  toId      Int
  createdAt DateTime @default(now())

  from User @relation("FriendshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendshipTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  rating    Int
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}
