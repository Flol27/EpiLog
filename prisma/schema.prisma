// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  id    Int     @id @default(autoincrement())
  isbn  String  @unique
  title String?

  bookUsers BookUser[]
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  username          String    @unique
  password          String
  role              String    @default("user")
  firstname         String
  lastname          String?
  readStreak        Int       @default(0)
  readStreakUpdated DateTime?
  profilePic        String?
  status            String?
  quote             String?
  createdAt         DateTime  @default(now())

  bookUsers         BookUser[]

  // Friendships where this user is the initiator
  friendshipsFrom   Friendship[] @relation("FriendshipFrom")
  // Friendships where this user was added
  friendshipsTo     Friendship[] @relation("FriendshipTo")
}

model BookUser {
  userId     Int
  bookId     Int
  pagesRead  Int?
  startDate  DateTime?
  readDate   DateTime?
  rating     Int?
  ratingText String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, bookId])
}

model Friendship {
  id        Int      @id @default(autoincrement())
  fromId    Int
  toId      Int
  createdAt DateTime @default(now())

  from User @relation("FriendshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendshipTo",   fields: [toId],   references: [id], onDelete: Cascade)

  // Each pair can only be connected once
  @@unique([fromId, toId])
}
